@model IReadOnlyList<ASP_FinancialProductWishList.ViewModels.LikeListItemViewModel>

@{
    ViewData["Title"] = "我的喜好清單";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">我的喜好清單</h1>

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-primary">
        前往挑選商品
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        目前尚未加入任何喜好金融商品。
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">商品名稱</th>
                    <th scope="col">扣款帳號</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-end">價格</th>
                    <th scope="col" class="text-end">費率</th>
                    <th scope="col" class="text-end">數量</th>
                    <th scope="col" class="text-end">商品金額</th>
                    <th scope="col" class="text-end">手續費</th>
                    <th scope="col" class="text-end">扣款總額</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.MaskedDebitAccount</td>
                        <td>@item.Email</td>
                        <td class="text-end">
                            NT$ @item.Price.ToString("N2")
                        </td>
                        <td class="text-end">
                            @item.FeeRate.ToString("P2")
                        </td>
                        <td class="text-end">
                            @item.Quantity.ToString("N0")
                        </td>
                        <td class="text-end">
                            NT$ @item.ProductAmount.ToString("N2")
                        </td>
                        <td class="text-end">
                            NT$ @item.Fee.ToString("N2")
                        </td>
                        <td class="text-end fw-semibold">
                            NT$ @item.TotalAmount.ToString("N2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}